{
  "name": "Demo · Lead Routing",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "parameters": {"hook": 100},
      "mapper": null
    },
    {
      "id": 2,
      "module": "builtin:BasicRouter",
      "routes": [
        {
          "flow": [
            {
              "id": 3,
              "module": "http:ActionSendData",
              "filter": {
                "name": "Qualified leads only",
                "conditions": [[{"a": "{{1.score}}", "o": "number:greater", "b": "50"}]]
              },
              "mapper": {
                "url": "https://crm.example.invalid/leads",
                "method": "post",
                "headers": [{"name": "Authorization", "value": "DEMO-TOKEN"}],
                "data": "{{1.email}}"
              },
              "onerror": [
                {"id": 4, "module": "slack:CreateMessage", "mapper": {"text": "Demo error"}}
              ]
            }
          ]
        },
        {
          "flow": [
            {"id": 5, "module": "google-sheets:addRow", "mapper": {"email": "{{1.email}}"}}
          ]
        }
      ]
    }
  ],
  "metadata": {"version": 1}
}
